<UserControl x:Class="FactoryApp.InventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sysglobe="clr-namespace:System.Globalization;assembly=System.Runtime"
        xmlns:converters="clr-namespace:FactoryApp.Converters"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

    <UserControl.Resources>
        <converters:PathToImageSourceConverter x:Key="PathToImageConverter"/>
        <converters:IsNegativeDecimalConverter x:Key="IsNegativeDecimalConverter"/>
        <Style x:Key="InventoryDataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource InventoryRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding AvailableInStorage, Converter={StaticResource IsNegativeDecimalConverter}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SemanticNoticeBackgroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AvailableStockTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Padding" Value="5,3"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AvailableInStorage, Converter={StaticResource IsNegativeDecimalConverter}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ChromeBackgroundBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Content="← رجوع"
                        Style="{StaticResource ToolbarButtonStyle}" Click="BackButton_Click"/>
                <TextBlock Grid.Column="1" Text="المخزن" Style="{StaticResource ModulePageTitleText}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrintInventoryButton" Content="طباعة…"
                            Style="{StaticResource ToolbarButtonStyle}" Padding="12,6" Margin="0,0,8,0" FontSize="11"
                            Click="PrintInventory_Click"
                            ToolTip="طباعة جدول المخزن والملخص (PDF عبر النظام)."/>
                    <Button x:Name="SavePdfInventoryButton" Content="حفظ PDF…"
                            Style="{StaticResource PrimaryActionButtonStyle}" Padding="12,6" Margin="0,0,8,0" FontSize="11"
                            Click="SavePdfInventory_Click"
                            ToolTip="حفظ جدول المخزن والملخص كملف PDF."/>
                    <Button x:Name="RefreshButton" Content="تحديث"
                            Style="{StaticResource ToolbarButtonStyle}" Padding="12,6" FontSize="11"
                            Click="RefreshButton_Click"
                            ToolTip="فتح نافذة تحديث الإنتاج: عرض الإنتاج المُسجَّل وإضافة كميات جديدة للمخزن"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10,10,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="260"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    Effect="{StaticResource ModuleCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource SurfacePanelHeaderBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                            Padding="12,10" CornerRadius="10,10,0,0">
                        <TextBlock Text="معاينة الصورة" Style="{StaticResource SectionTitleText}" FontSize="13"/>
                    </Border>
                    <Grid Grid.Row="1" MinHeight="200">
                        <TextBlock x:Name="PhotoPreviewPlaceholder" Margin="16" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                                   Style="{StaticResource HelperMutedText}"
                                   Text="اختر صفاً من الجدول أو انقر الصورة المصغّرة لعرضها هنا بحجم أكبر."/>
                        <ScrollViewer x:Name="PhotoPreviewScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,12,12,14">
                            <StackPanel x:Name="PhotoPreviewPanel">
                                <Border Background="{DynamicResource SurfacePanelHeaderBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="10" HorizontalAlignment="Center" MinWidth="200" MinHeight="200" MaxWidth="276">
                                    <Grid MinHeight="200">
                                        <Image x:Name="PhotoPreviewLargeImage" Stretch="Uniform" MaxWidth="256" MaxHeight="400" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PhotoPreviewNoFileText" Text="لا توجد صورة لهذا الصنف" TextWrapping="Wrap" TextAlignment="Center"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="PhotoPreviewNameText" Margin="0,12,0,4" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PhotoPreviewDdidText" Style="{StaticResource CaptionLabelText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True"/>

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    Padding="16,14" Effect="{StaticResource ModuleCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="مركز التحكم بالمخزون" Style="{StaticResource SectionTitleText}" Margin="0,0,0,6"/>
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource HelperMutedText}" TextWrapping="Wrap"
                                   Text="استخدم زر «تحديث» لإضافة إنتاج (من نافذة التحديث). «طلبات العملاء» = مجموع كميات الإيصالات؛ «الاحتياج» = طلبات العملاء ناقص مسلّم للعملاء. انقر الصورة للمعاينة. يُنقص «المتوفر» بكل تسليم."/>
                        <TextBlock Style="{StaticResource HelperMutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource SemanticNoticeForegroundBrush}">
                            <Run FontWeight="SemiBold" Text="عندما يكون «المتوفر» سالباً: "/>
                            <Run Text="طلبات التسليم أكبر من المتاح — أضف إنتاجاً من «تحديث» أو راجع أقسام التسليم. الصف يُظلّل للتنبيه."/>
                        </TextBlock>
                    </StackPanel>

                    <DataGrid x:Name="InventoryDataGrid"
                              Grid.Row="2"
                              Style="{StaticResource DataGridModuleStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              MinHeight="240"
                              RowHeight="36"
                              IsReadOnly="False"
                              AlternationCount="2"
                              RowStyle="{StaticResource InventoryDataGridRowStyle}"
                              ColumnHeaderStyle="{StaticResource LedgerColumnHeaderStyle}"
                              CellStyle="{StaticResource LedgerCellStyle}"
                              CellEditEnding="InventoryDataGrid_CellEditEnding"
                              SelectionChanged="InventoryDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DDID" Binding="{Binding Ddid}" Width="110" MinWidth="90" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="5,3"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="الصورة" Width="68" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding PhotoPath, Converter={StaticResource PathToImageConverter}, ConverterParameter=56}"
                                               MaxHeight="28" MaxWidth="56" Stretch="Uniform" HorizontalAlignment="Center"
                                               Cursor="Hand" ToolTip="انقر لعرض الصورة بحجم أكبر في الشريط"
                                               MouseLeftButtonDown="InventoryThumbnailImage_MouseLeftButtonDown"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*" MinWidth="140" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="5,3"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="طلبات العملاء"
                                                Binding="{Binding TotalOrderedOnCustomerReceipts, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}"
                                                Width="120" MinWidth="96" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="5,3"/>
                                        <Setter Property="ToolTip" Value="مجموع كمية الإيصال في جميع إيصالات العملاء لهذا الـ DDID."/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="مسلّم للعملاء"
                                                Binding="{Binding TotalDeliveredToCustomers, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}"
                                                Width="120" MinWidth="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="5,3"/>
                                        <Setter Property="ToolTip" Value="مجموع الكميات في أقسام التسليم لإيصالات العملاء لهذا الـ DDID."/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="الاحتياج"
                                                Binding="{Binding CurrentOutstandingCustomerNeed, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}"
                                                Width="120" MinWidth="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="5,3"/>
                                        <Setter Property="ToolTip" Value="طلبات العملاء ناقص مسلّم للعملاء — ما يبقى لتلبيته من الطلبات."/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="المتوفر في المخزن"
                                                Binding="{Binding AvailableInStorage, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}"
                                                Width="130" IsReadOnly="False">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AvailableStockTextStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
