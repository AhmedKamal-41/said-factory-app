<UserControl x:Class="FactoryApp.ThemeToggleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <Button x:Name="RootButton"
            Style="{StaticResource ThemeToggleButtonStyle}"
            Click="OnClick"
            VerticalAlignment="Center"
            ToolTip="تبديل المظهر">
        <StackPanel Orientation="Horizontal">
            <Grid Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,0,0">
                <Path x:Name="MoonPath"
                      Data="{StaticResource ThemeIconMoonGeometry}"
                      Fill="{DynamicResource ThemeToggleForegroundBrush}"
                      Stretch="Uniform"/>
                <Path x:Name="SunPath"
                      Data="{StaticResource ThemeIconSunGeometry}"
                      Fill="{DynamicResource ThemeToggleForegroundBrush}"
                      Stretch="Uniform"
                      Visibility="Collapsed"/>
            </Grid>
            <TextBlock x:Name="LabelText"
                       Margin="8,0,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource ThemeToggleForegroundBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
</UserControl>
