<UserControl x:Class="FactoryApp.FactoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sysglobe="clr-namespace:System.Globalization;assembly=System.Runtime"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ChromeBackgroundBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Content="← رجوع"
                        Style="{StaticResource ToolbarButtonStyle}" Click="BackButton_Click"/>
                <TextBlock Grid.Column="1" Text="حسابات المصنع" Style="{StaticResource ModulePageTitleText}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrintFactoryButton" Content="طباعة…"
                            Style="{StaticResource ToolbarButtonStyle}" Padding="12,6" Margin="0,0,8,0" FontSize="11"
                            Click="PrintFactory_Click"
                            ToolTip="طباعة جدول الحسابات والملخص (PDF عبر النظام)."/>
                    <Button x:Name="SavePdfFactoryButton" Content="حفظ PDF…"
                            Style="{StaticResource PrimaryActionButtonStyle}" Padding="12,6" FontSize="11"
                            Click="SavePdfFactory_Click"
                            ToolTip="حفظ جدول الحسابات والملخص كملف PDF."/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    Padding="16,14" Margin="0,0,4,0" Effect="{StaticResource ModuleCardShadow}" VerticalAlignment="Stretch">
                <Grid MinHeight="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="جدول الحسابات" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="AddRowButton" Content="+ إضافة صف" Style="{StaticResource PrimaryActionButtonStyle}"
                                            Padding="12,6" Margin="0,0,8,0" FontSize="11" Click="AddRow_Click"/>
                                    <Button x:Name="DeleteRowButton" Content="حذف الصف" Style="{StaticResource ToolbarButtonStyle}"
                                            Padding="12,6" FontSize="11" Click="DeleteRow_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="1" Style="{StaticResource HelperMutedText}" Margin="0,0,0,12"
                                       Text="تكاليف الإنتاج لكل بند؛ الحقول المحسوبة تُحدَّث تلقائياً. الإجماليات في الشريط أسفل الصفحة."/>

                            <DataGrid x:Name="EntriesDataGrid" Grid.Row="2" MinHeight="180"
                                      Style="{StaticResource DataGridModuleStyle}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      RowHeight="34"
                                      AlternationCount="2"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      RowStyle="{StaticResource LedgerRowStyle}"
                                      ColumnHeaderStyle="{StaticResource LedgerColumnHeaderStyle}"
                                      CellStyle="{StaticResource LedgerCellStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الاسم" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="160" MinWidth="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="5,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Padding" Value="4,2"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="كيلو" Binding="{Binding Kilo, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}" Width="80" MinWidth="65">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="5,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="4,2"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="سعر الكيلو" Binding="{Binding PricePerKilo, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}" Width="95" MinWidth="75">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="5,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="4,2"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="إجمالي السعر" Binding="{Binding TotalPrice, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}" Width="105" MinWidth="85" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="5,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="عدد التي شيرت" Binding="{Binding ShirtCount, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}" Width="105" MinWidth="85">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="5,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="4,2"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="سعر القطعة" Binding="{Binding PricePerShirt, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}" Width="105" MinWidth="85" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="5,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="المصنعية" Binding="{Binding ManufacturingCost, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}" Width="90" MinWidth="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="5,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="4,2"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="الهالك" Binding="{Binding Waste, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}" Width="80" MinWidth="65">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="5,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="4,2"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="طباعة" Binding="{Binding PrintingCost, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}" Width="80" MinWidth="65">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="5,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="4,2"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="تكلفة التي شيرت" Binding="{Binding CostPerShirt, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}" Width="115" MinWidth="95" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="5,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="التكلفة الكل" Binding="{Binding TotalCostAll, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}" Width="105" MinWidth="85" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="5,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource SurfacePanelHeaderBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    Padding="16,14" Margin="0,12,4,0" Effect="{StaticResource ModuleCardShadow}" VerticalAlignment="Bottom">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="ملخص المجاميع" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="إجمالي السعر:" FontSize="12" Foreground="{DynamicResource TextCaptionBrush}" Margin="0,0,6,6"/>
                        <TextBlock x:Name="TotalPriceSumText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,24,6"/>
                        <TextBlock Text="عدد التي شيرت:" FontSize="12" Foreground="{DynamicResource TextCaptionBrush}" Margin="0,0,6,6"/>
                        <TextBlock x:Name="TotalShirtCountText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,24,6"/>
                        <TextBlock Text="المصنعية:" FontSize="12" Foreground="{DynamicResource TextCaptionBrush}" Margin="0,0,6,6"/>
                        <TextBlock x:Name="TotalManufacturingText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,24,6"/>
                        <TextBlock Text="الهالك:" FontSize="12" Foreground="{DynamicResource TextCaptionBrush}" Margin="0,0,6,6"/>
                        <TextBlock x:Name="TotalWasteText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,24,6"/>
                        <TextBlock Text="طباعة:" FontSize="12" Foreground="{DynamicResource TextCaptionBrush}" Margin="0,0,6,6"/>
                        <TextBlock x:Name="TotalPrintingText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,24,6"/>
                        <TextBlock Text="تكلفة التي شيرت (مجموع):" FontSize="12" Foreground="{DynamicResource TextCaptionBrush}" Margin="0,0,6,6"/>
                        <TextBlock x:Name="TotalCostPerShirtSumText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,24,6"/>
                        <TextBlock Text="التكلفة الكل:" FontSize="12" Foreground="{DynamicResource TextCaptionBrush}" Margin="0,0,6,6"/>
                        <TextBlock x:Name="TotalCostAllSumText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningForegroundBrush}" Margin="0,0,0,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
