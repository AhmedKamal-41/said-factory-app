<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ModuleCardShadowColor">#300C111A</Color>
    <Color x:Key="TileShadowColor">#280C111A</Color>

    <!-- Canvas & surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EDF0F4"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F3F5F8"/>
    <SolidColorBrush x:Key="SurfacePanelHeaderBrush" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#DDE3EB"/>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#B8C4D0"/>

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0C111A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4A5568"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="TextCaptionBrush" Color="#5C6570"/>
    <SolidColorBrush x:Key="PlaceholderForegroundBrush" Color="#9AA3AF"/>

    <!-- Chrome & dashboard chrome -->
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#DDE3EB"/>
    <SolidColorBrush x:Key="AccentBarBrush" Color="#1B4FD6"/>
    <SolidColorBrush x:Key="HeadlineForegroundBrush" Color="#0C111A"/>
    <SolidColorBrush x:Key="SubheadForegroundBrush" Color="#4A5568"/>

    <SolidColorBrush x:Key="DashboardCardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DashboardCardBorderBrush" Color="#C5CED8"/>
    <SolidColorBrush x:Key="DashboardDividerBrush" Color="#E2E7EE"/>

    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="FooterBorderBrush" Color="#DDE3EB"/>
    <SolidColorBrush x:Key="FooterForegroundBrush" Color="#8B95A1"/>

    <!-- Dashboard tiles -->
    <SolidColorBrush x:Key="NavTileBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavTileBorderBrush" Color="#DDE3EB"/>
    <SolidColorBrush x:Key="NavTileHoverBackgroundBrush" Color="#F6F8FB"/>
    <SolidColorBrush x:Key="NavTileHoverBorderBrush" Color="#B8C4D0"/>
    <SolidColorBrush x:Key="NavTilePressedBackgroundBrush" Color="#E8ECF2"/>

    <SolidColorBrush x:Key="SectionTitleForegroundBrush" Color="#374151"/>
    <SolidColorBrush x:Key="TileTitleForegroundBrush" Color="#0C111A"/>
    <SolidColorBrush x:Key="TileHintForegroundBrush" Color="#5C6570"/>

    <SolidColorBrush x:Key="IconWellBlueBackgroundBrush" Color="#E8F0FE"/>
    <SolidColorBrush x:Key="IconWellBlueBorderBrush" Color="#A8C5F5"/>
    <SolidColorBrush x:Key="IconWellBlueForegroundBrush" Color="#1B4FD6"/>

    <SolidColorBrush x:Key="IconWellGreenBackgroundBrush" Color="#E8F7ED"/>
    <SolidColorBrush x:Key="IconWellGreenBorderBrush" Color="#9FD4AE"/>
    <SolidColorBrush x:Key="IconWellGreenForegroundBrush" Color="#166534"/>

    <SolidColorBrush x:Key="IconWellOrangeBackgroundBrush" Color="#FFF1E6"/>
    <SolidColorBrush x:Key="IconWellOrangeBorderBrush" Color="#F5C09A"/>
    <SolidColorBrush x:Key="IconWellOrangeForegroundBrush" Color="#B45309"/>

    <SolidColorBrush x:Key="IconWellIndigoBackgroundBrush" Color="#ECEFFF"/>
    <SolidColorBrush x:Key="IconWellIndigoBorderBrush" Color="#B4B9F7"/>
    <SolidColorBrush x:Key="IconWellIndigoForegroundBrush" Color="#4338CA"/>

    <SolidColorBrush x:Key="IconWellPurpleBackgroundBrush" Color="#F3EEFB"/>
