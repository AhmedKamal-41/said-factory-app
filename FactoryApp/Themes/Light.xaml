    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DataGridRowAltBackgroundBrush" Color="#F6F8FB"/>
    <SolidColorBrush x:Key="DataGridCellForegroundBrush" Color="#0C111A"/>

    <!-- Lists & inputs -->
    <SolidColorBrush x:Key="ListItemSelectedBackgroundBrush" Color="#D6E4FF"/>
    <SolidColorBrush x:Key="ListItemSelectedForegroundBrush" Color="#0C111A"/>
    <SolidColorBrush x:Key="ListItemHoverBackgroundBrush" Color="#EEF1F6"/>

    <SolidColorBrush x:Key="InputChromeBackgroundBrush" Color="#F6F8FB"/>
    <SolidColorBrush x:Key="InputChromeBorderBrush" Color="#DDE3EB"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#166534"/>
    <SolidColorBrush x:Key="WarningForegroundBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="SemanticOverdueRowBackgroundBrush" Color="#FDECEC"/>
    <SolidColorBrush x:Key="SemanticOverdueRowForegroundBrush" Color="#B91C1C"/>

    <SolidColorBrush x:Key="SemanticNoticeBackgroundBrush" Color="#FFF8E6"/>
    <SolidColorBrush x:Key="SemanticNoticeBorderBrush" Color="#F5D78E"/>
    <SolidColorBrush x:Key="SemanticNoticeForegroundBrush" Color="#B45309"/>

    <SolidColorBrush x:Key="SuccessSoftBackgroundBrush" Color="#E8F5E9"/>
    <SolidColorBrush x:Key="SuccessSoftBorderBrush" Color="#81C784"/>
    <SolidColorBrush x:Key="SuccessStrongForegroundBrush" Color="#166534"/>

    <!-- Dialogs -->
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#DDE3EB"/>
</ResourceDictionary>
