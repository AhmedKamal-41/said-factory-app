    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DataGridBorderBrush" Color="#DDE3EB"/>
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#E8ECF2"/>
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#374151"/>
    <SolidColorBrush x:Key="DataGridHeaderBorderBrush" Color="#DDE3EB"/>
