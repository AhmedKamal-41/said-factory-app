    <SolidColorBrush x:Key="IconWellPurpleForegroundBrush" Color="#6D28D9"/>

    <SolidColorBrush x:Key="IconWellSkyBackgroundBrush" Color="#E5F4FC"/>
    <SolidColorBrush x:Key="IconWellSkyBorderBrush" Color="#93D0F0"/>
    <SolidColorBrush x:Key="IconWellSkyForegroundBrush" Color="#0369A1"/>

    <SolidColorBrush x:Key="ThemeToggleBackgroundBrush" Color="#E8ECF2"/>
    <SolidColorBrush x:Key="ThemeToggleBorderBrush" Color="#B8C4D0"/>
    <SolidColorBrush x:Key="ThemeToggleForegroundBrush" Color="#374151"/>
    <SolidColorBrush x:Key="ThemeToggleHoverBackgroundBrush" Color="#DDE3EB"/>

    <!-- Toolbar & primary actions -->
    <SolidColorBrush x:Key="ToolbarButtonBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToolbarButtonBorderBrush" Color="#B8C4D0"/>
    <SolidColorBrush x:Key="ToolbarButtonHoverBackgroundBrush" Color="#F3F5F8"/>
    <SolidColorBrush x:Key="ToolbarButtonPressedBackgroundBrush" Color="#E8ECF2"/>
    <SolidColorBrush x:Key="ToolbarButtonForegroundBrush" Color="#0C111A"/>

    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#1B4FD6"/>
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="#153DB0"/>
