<Window x:Class="FactoryApp.InventoryProductionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sysglobe="clr-namespace:System.Globalization;assembly=System.Runtime"
        Title="تحديث الإنتاج"
        Height="520"
        Width="720"
        MinHeight="400"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="تحديث الإنتاج" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Style="{StaticResource HelperMutedText}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="يظهر لكل صنف ما هو مُسجَّل حالياً. في عمود «أضف» اكتب الكمية الجديدة التي أنتجتها؛ تُضاف إلى المُسجَّل ويُزاد «المتوفر» في المخزن بنفس القدر. اترك 0 أو فارغاً إن لم يكن هناك إضافة."/>

        <DataGrid x:Name="RowsDataGrid"
                  Grid.Row="2"
                  Style="{StaticResource DataGridModuleStyle}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  MinHeight="200"
                  RowHeight="34"
                  AlternationCount="2"
                  RowStyle="{StaticResource LedgerRowStyle}"
                  ColumnHeaderStyle="{StaticResource LedgerColumnHeaderStyle}"
                  CellStyle="{StaticResource LedgerCellStyle}"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="DDID" Binding="{Binding Ddid}" Width="100" MinWidth="88" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="5,3"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*" MinWidth="140" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="5,3"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="المُسجَّل حالياً"
                                    Binding="{Binding CurrentProduced, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}"
                                    Width="120" MinWidth="100" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="5,3"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="أضف (للمخزن)"
                                    Binding="{Binding AddAmountText, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120" MinWidth="100" IsReadOnly="False">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="5,3"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="4,2"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight">
            <Button Content="حفظ" Width="100" Height="34" Margin="0,0,8,0" Click="Save_Click" IsDefault="True"
                    Style="{StaticResource PrimaryActionButtonStyle}"/>
            <Button Content="إلغاء" Width="100" Height="34" Click="Cancel_Click" IsCancel="True"
                    Style="{StaticResource ToolbarButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
