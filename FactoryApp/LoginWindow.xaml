<Window x:Class="FactoryApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app.ico"
        Title="تسجيل الدخول"
        Height="320"
        Width="400"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>
        <Geometry x:Key="PasswordEyeShowGeometry">M2,12 Q12,2 22,12 Q12,22 2,12 M12,15 A3,3 0 1 1 12,9 A3,3 0 1 1 12,15 Z</Geometry>
        <Geometry x:Key="PasswordEyeHideGeometry">M2,12 Q12,2 22,12 Q12,22 2,12 M12,15 A3,3 0 1 1 12,9 A3,3 0 1 1 12,15 Z M3,4 L20,20</Geometry>
        <Style x:Key="PasswordRevealToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="ToolTip" Value="إظهار كلمة المرور"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <Path x:Name="Icon" Width="18" Height="18" Stretch="Uniform"
                                  Fill="{DynamicResource TextPrimaryBrush}"
                                  Data="{StaticResource PasswordEyeShowGeometry}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Data" Value="{StaticResource PasswordEyeHideGeometry}"/>
                                <Setter Property="ToolTip" Value="إخفاء كلمة المرور"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid x:Name="FirstRunPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="أنشئ كلمة مرور لحماية التطبيق" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <TextBlock Grid.Row="1" Text="كلمة المرور:" FontSize="14" Margin="0,0,0,8"/>
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12" Padding="0,0,2,0">
                <Grid FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="NewPasswordRevealToggle" Grid.Column="0"
                                  Style="{StaticResource PasswordRevealToggleStyle}"
                                  Checked="PasswordReveal_Changed" Unchecked="PasswordReveal_Changed"/>
                    <Grid Grid.Column="1">
                        <PasswordBox x:Name="NewPasswordBox" FontSize="14" Padding="8,6" BorderThickness="0"
                                     Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"/>
                        <TextBox x:Name="NewPasswordTextBox" FontSize="14" Padding="8,6" BorderThickness="0" Visibility="Collapsed"
                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>
                </Grid>
            </Border>
            <TextBlock Grid.Row="3" Text="تأكيد كلمة المرور:" FontSize="14" Margin="0,0,0,8"/>
            <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,16" Padding="0,0,2,0">
                <Grid FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="ConfirmPasswordRevealToggle" Grid.Column="0"
                                  Style="{StaticResource PasswordRevealToggleStyle}"
                                  Checked="PasswordReveal_Changed" Unchecked="PasswordReveal_Changed"/>
                    <Grid Grid.Column="1">
                        <PasswordBox x:Name="ConfirmPasswordBox" FontSize="14" Padding="8,6" BorderThickness="0"
                                     Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"/>
                        <TextBox x:Name="ConfirmPasswordTextBox" FontSize="14" Padding="8,6" BorderThickness="0" Visibility="Collapsed"
                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>
                </Grid>
            </Border>
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight">
                <Button Content="متابعة" Width="100" Height="32" Margin="0,0,8,0" Click="FirstRunOk_Click" IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}"/>
                <Button Content="خروج" Width="80" Height="32" Click="Cancel_Click" IsCancel="True"
                        Style="{StaticResource ToolbarButtonStyle}"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="LoginPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="أدخل كلمة المرور للمتابعة" FontSize="14" Margin="0,0,0,16"/>
            <TextBlock Grid.Row="1" Text="كلمة المرور:" FontSize="14" Margin="0,0,0,8"/>
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,16" Padding="0,0,2,0">
                <Grid FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="LoginPasswordRevealToggle" Grid.Column="0"
                                  Style="{StaticResource PasswordRevealToggleStyle}"
                                  Checked="PasswordReveal_Changed" Unchecked="PasswordReveal_Changed"/>
                    <Grid Grid.Column="1">
                        <PasswordBox x:Name="LoginPasswordBox" FontSize="14" Padding="8,6" BorderThickness="0"
                                     Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"/>
                        <TextBox x:Name="LoginPasswordTextBox" FontSize="14" Padding="8,6" BorderThickness="0" Visibility="Collapsed"
                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>
                </Grid>
            </Border>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight">
                <Button Content="دخول" Width="80" Height="32" Margin="0,0,8,0" Click="LoginOk_Click" IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}"/>
                <Button Content="إلغاء" Width="80" Height="32" Click="Cancel_Click" IsCancel="True"
                        Style="{StaticResource ToolbarButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
