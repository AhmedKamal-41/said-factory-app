<Window x:Class="FactoryApp.TreasuryPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الخزنة"
        Height="220"
        Width="380"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="أدخل كلمة مرور الخزنة للمتابعة." FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <TextBlock Grid.Row="1" Text="كلمة المرور:" FontSize="14" Margin="0,0,0,8"/>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,16">
            <PasswordBox x:Name="PasswordBox" FontSize="14" Padding="8,6" BorderThickness="0"
                         Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"/>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight">
            <Button Content="دخول" Width="88" Height="32" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"
                    Style="{StaticResource PrimaryActionButtonStyle}"/>
            <Button Content="إلغاء" Width="80" Height="32" Click="Cancel_Click" IsCancel="True"
                    Style="{StaticResource ToolbarButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
