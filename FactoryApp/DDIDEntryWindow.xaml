<UserControl x:Class="FactoryApp.DDIDEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ChromeBackgroundBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Content="← رجوع"
                        Style="{StaticResource ToolbarButtonStyle}" Click="BackButton_Click"/>
                <TextBlock Grid.Column="1" Text="إدخال DDID" Style="{StaticResource ModulePageTitleText}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10,10,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    Effect="{StaticResource ModuleCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource SurfacePanelHeaderBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,10" CornerRadius="10,10,0,0">
                        <TextBlock Text="المنتجات" Style="{StaticResource SectionTitleText}" FontSize="13"/>
                    </Border>
                    <ListBox x:Name="ProductsListBox"
                             Grid.Row="1"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="4,6"
                             ItemContainerStyle="{StaticResource ProductListItemStyle}"
                             SelectionChanged="ProductsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding DDID}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True"/>

            <Border Grid.Column="2" Background="Transparent" BorderThickness="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="16,14" Effect="{StaticResource ModuleCardShadow}">
                        <StackPanel>
                            <TextBlock Text="تفاصيل المنتج" Style="{StaticResource SectionTitleText}" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource HelperMutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"
                                       Text="DDID فريد لكل صنف؛ الصورة اختيارية وتُستخدم في شاشة العملاء عند اختيار المنتج."/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="DDID" Style="{StaticResource FormLabelText}" Margin="0,0,12,10"/>
                                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
                                    <TextBox x:Name="DdidTextBox" Style="{StaticResource FormTextBoxStyle}" MinWidth="200"/>
                                </Border>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="الاسم" Style="{StaticResource FormLabelText}" Margin="0,0,12,10"/>
                                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
                                    <TextBox x:Name="NameTextBox" Style="{StaticResource FormTextBoxStyle}" MinWidth="200"/>
                                </Border>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="الصورة" Style="{StaticResource FormLabelText}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <Button x:Name="SelectPhotoButton"
                                        Grid.Row="2" Grid.Column="1"
                                        Content="اختيار صورة"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Padding="12,6"
                                        HorizontalAlignment="Right"
                                        Click="SelectPhotoButton_Click"/>
                            </Grid>

                            <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Height="220" Margin="0,16,0,0" Background="{DynamicResource SurfacePanelHeaderBrush}">
                                <Grid>
                                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8"/>
                                    <TextBlock x:Name="PreviewNoPhotoText"
                                               Text="لا توجد صورة"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource PlaceholderForegroundBrush}"
                                               TextAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="الإجراءات" Style="{StaticResource SectionTitleText}" Margin="0,20,0,10"/>
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right">
                                <Button Content="إضافة" Style="{StaticResource PrimaryActionButtonStyle}" MinWidth="100" Padding="14,8" Margin="0,0,8,0" Click="AddButton_Click"/>
                                <Button Content="تحديث" Style="{StaticResource ToolbarButtonStyle}" MinWidth="100" Padding="14,8" Margin="0,0,8,0" Click="UpdateButton_Click"/>
                                <Button Content="حذف" Style="{StaticResource ToolbarButtonStyle}" MinWidth="100" Padding="14,8" Margin="0,0,8,0" Click="DeleteButton_Click"/>
                                <Button Content="مسح" Style="{StaticResource ToolbarButtonStyle}" MinWidth="90" Padding="14,8" Click="ClearButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
