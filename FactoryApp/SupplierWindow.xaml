<UserControl x:Class="FactoryApp.SupplierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sysglobe="clr-namespace:System.Globalization;assembly=System.Runtime"
        xmlns:converters="clr-namespace:FactoryApp.Converters"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

    <UserControl.Resources>
        <converters:PathToImageSourceConverter x:Key="PathToImageConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ChromeBackgroundBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Content="← رجوع"
                        Style="{StaticResource ToolbarButtonStyle}" Click="BackButton_Click"/>
                <TextBlock Grid.Column="1" Text="المورد" Style="{StaticResource ModulePageTitleText}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrintButton" Content="طباعة…" IsEnabled="False"
                            Style="{StaticResource ToolbarButtonStyle}" Padding="12,6" Margin="0,0,8,0" FontSize="11"
                            Click="Print_Click"
                            ToolTip="طباعة تقرير المورد الحالي (PDF عبر النظام)."/>
                    <Button x:Name="SavePdfButton" Content="حفظ PDF…" IsEnabled="False"
                            Style="{StaticResource PrimaryActionButtonStyle}" Padding="12,6" FontSize="11"
                            Click="SavePdf_Click"
                            ToolTip="حفظ تقرير المورد كملف PDF."/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10,10,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    Effect="{StaticResource ModuleCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource SurfacePanelHeaderBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,10" CornerRadius="10,10,0,0">
                        <TextBlock Text="الموردين" Style="{StaticResource SectionTitleText}" FontSize="13"/>
                    </Border>
                    <ListBox x:Name="SupplierListBox" Grid.Row="1"
                             DisplayMemberPath="Name"
                             SelectionChanged="SupplierListBox_SelectionChanged"
                             BorderThickness="0" Background="Transparent" Padding="4,6"
                             ItemContainerStyle="{StaticResource SupplierListItemStyle}"/>
                    <StackPanel Grid.Row="2" Orientation="Vertical" Margin="12,10,12,14">
                        <Button x:Name="AddSupplierButton" Content="إضافة مورد" Style="{StaticResource PrimaryActionButtonStyle}"
                                Click="AddSupplier_Click" Margin="0,0,0,8"/>
                        <Button x:Name="DeleteSupplierButton" Content="حذف مورد" Style="{StaticResource ToolbarButtonStyle}"
                                Click="DeleteSupplier_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True"/>

            <Border x:Name="DetailsPanel" Grid.Column="2" Background="Transparent" BorderThickness="0"
                    Visibility="Collapsed">
                <Grid Margin="0,0,4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" MinHeight="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Padding="16,14" Margin="0,0,0,16" Effect="{StaticResource ModuleCardShadow}">
                            <TextBlock x:Name="SupplierNameText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>

                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Padding="16,14" Margin="0,0,0,16" Effect="{StaticResource ModuleCardShadow}">
                            <Expander Header="صور الإيصال" IsExpanded="True" ExpandDirection="Down"
                                      Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13">
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10" FlowDirection="RightToLeft">
                                        <Button x:Name="AddReceiptImagesButton" Content="إضافة صور" Style="{StaticResource PrimaryActionButtonStyle}"
                                                Padding="12,6" Margin="0,0,6,0" FontSize="11" Click="AddReceiptImages_Click"/>
                                        <Button x:Name="RemoveReceiptImagesButton" Content="إزالة المحدد" Style="{StaticResource ToolbarButtonStyle}"
                                                Padding="10,6" FontSize="11" Click="RemoveSelectedReceiptImages_Click"/>
                                    </StackPanel>
                                    <ListBox Grid.Row="1" x:Name="ReceiptImagesList"
                                             ItemsSource="{Binding ReceiptImagePaths}"
                                             SelectionMode="Extended"
                                             MaxHeight="260"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" MaxWidth="780"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,8,8"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ListItemSelectedBackgroundBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="8" Background="{DynamicResource SurfacePanelHeaderBrush}" CornerRadius="8" MinWidth="120" MinHeight="90">
                                                    <Image Source="{Binding Converter={StaticResource PathToImageConverter}, ConverterParameter=400}"
                                                           MaxWidth="220" MaxHeight="160" Stretch="Uniform"/>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Expander>
                        </Border>

                        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Padding="16,14" Margin="0,0,0,0" Effect="{StaticResource ModuleCardShadow}" VerticalAlignment="Stretch">
                            <Grid MinHeight="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="سجل الأعمال" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft">
                                        <Button x:Name="AddEntryButton" Content="+ إضافة صف" Style="{StaticResource PrimaryActionButtonStyle}"
                                                Padding="12,6" Margin="0,0,6,0" FontSize="11" Click="AddEntry_Click"/>
                                        <Button x:Name="DeleteEntryButton" Content="حذف الصف" Style="{StaticResource ToolbarButtonStyle}"
                                                Padding="10,6" FontSize="11" Click="DeleteEntry_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" Style="{StaticResource HelperMutedText}" Margin="0,0,0,12"
                                           Text="سجل مشتريات الخام والمدفوعات لكل مورد؛ الإجماليات في الشريط أسفل الصفحة."/>

                                <DataGrid x:Name="EntriesDataGrid" Grid.Row="2" MinHeight="120"
                                          Style="{StaticResource DataGridModuleStyle}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          RowHeaderWidth="0"
                                          RowHeight="34"
                                          AlternationCount="2"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          RowStyle="{StaticResource LedgerRowStyle}"
                                          ColumnHeaderStyle="{StaticResource LedgerColumnHeaderStyle}"
                                          CellStyle="{StaticResource LedgerCellStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="وقت الشراء" Binding="{Binding PurchaseDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" MinWidth="120">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="5,3"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="4,2"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="الخامة" Binding="{Binding MaterialName}" Width="2*" MinWidth="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Padding" Value="5,3"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Padding" Value="4,2"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="الكمية kg" Binding="{Binding QuantityKg, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}" Width="110" MinWidth="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Padding" Value="5,3"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                    <Setter Property="Padding" Value="4,2"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="سعر الكيلو" Binding="{Binding PricePerKg, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}" Width="100" MinWidth="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Padding" Value="5,3"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                    <Setter Property="Padding" Value="4,2"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}" Width="100" MinWidth="80" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Padding" Value="5,3"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="المدفوع" Binding="{Binding Paid, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}" Width="100" MinWidth="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Padding" Value="5,3"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                    <Setter Property="Padding" Value="4,2"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="الباقي" Binding="{Binding Remaining, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}" Width="100" MinWidth="80" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Padding" Value="5,3"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource SurfacePanelHeaderBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                            Padding="16,14" Margin="0,12,0,0" Effect="{StaticResource ModuleCardShadow}" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="ملخص المورد" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="إجمالي المبيعات (Total):" FontSize="12" Foreground="{DynamicResource TextCaptionBrush}" Margin="0,0,6,6"/>
                                <TextBlock x:Name="TotalPriceText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,24,6"/>
                                <TextBlock Text="المدفوع:" FontSize="12" Foreground="{DynamicResource TextCaptionBrush}" Margin="0,0,6,6"/>
                                <TextBlock x:Name="TotalPaidText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,24,6"/>
                                <TextBlock Text="الباقي:" FontSize="12" Foreground="{DynamicResource TextCaptionBrush}" Margin="0,0,6,6"/>
                                <TextBlock x:Name="TotalRemainingText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningForegroundBrush}" Margin="0,0,24,6"/>
                                <TextBlock Text="الكمية kg:" FontSize="12" Foreground="{DynamicResource TextCaptionBrush}" Margin="0,0,6,6"/>
                                <TextBlock x:Name="TotalQuantityText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
