<UserControl x:Class="FactoryApp.TreasuryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sysglobe="clr-namespace:System.Globalization;assembly=System.Runtime"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ChromeBackgroundBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Content="← رجوع"
                        Style="{StaticResource ToolbarButtonStyle}" Click="BackButton_Click"/>
                <TextBlock Grid.Column="1" Text="الخزنة" Style="{StaticResource ModulePageTitleText}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrintButton" Content="طباعة…"
                            Style="{StaticResource ToolbarButtonStyle}" Padding="12,6" Margin="0,0,8,0" FontSize="11"
                            Click="Print_Click"
                            ToolTip="طباعة رصيد أول المدة وسجل الخزنة والملخص."/>
                    <Button x:Name="SavePdfButton" Content="حفظ PDF…"
                            Style="{StaticResource PrimaryActionButtonStyle}" Padding="12,6" FontSize="11"
                            Click="SavePdf_Click"
                            ToolTip="حفظ رصيد أول المدة وسجل الخزنة والملخص كملف PDF."/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MinHeight="0" Margin="0,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="16,14" Margin="0,0,0,16" Effect="{StaticResource ModuleCardShadow}">
                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" VerticalAlignment="Center">
                            <TextBlock Text="رصيد أول المدة" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Text="(يُستخدم كأساس سلسلة الأرصدة اليومية)" Style="{StaticResource HelperMutedText}"
                                       VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="280"/>
                            <Border Background="{DynamicResource InputChromeBackgroundBrush}" BorderBrush="{DynamicResource InputChromeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="0" MinWidth="120">
                                <TextBox x:Name="OpeningBalanceTextBox" Style="{StaticResource TreasuryTextBoxStyle}"
                                         LostFocus="OpeningBalanceTextBox_LostFocus"
                                         TextChanged="OpeningBalanceTextBox_TextChanged"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="16,14" Margin="0,0,0,0" Effect="{StaticResource ModuleCardShadow}" VerticalAlignment="Stretch">
                        <Grid MinHeight="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="سجل الخزنة اليومي" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="AddRecordButton" Content="+ إضافة سجل يومي" Style="{StaticResource PrimaryActionButtonStyle}"
                                            Padding="12,6" Margin="0,0,8,0" FontSize="11" Click="AddRecord_Click"/>
                                    <Button x:Name="DeleteRecordButton" Content="حذف السجل" Style="{StaticResource ToolbarButtonStyle}"
                                            Padding="12,6" FontSize="11" Click="DeleteRecord_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="1" Style="{StaticResource HelperMutedText}" Margin="0,0,0,12"
                                       Text="ترتيب الصفوف يحدد سلسلة الرصيد: كل صف يأخذ رصيد اليوم السابق من الصف السابق. ملخص الإجماليات في الشريط أسفل الصفحة."/>

                            <DataGrid x:Name="EntriesDataGrid" Grid.Row="2" MinHeight="160"
                                      Style="{StaticResource DataGridModuleStyle}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      RowHeight="34"
                                      AlternationCount="2"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      RowStyle="{StaticResource LedgerRowStyle}"
                                      ColumnHeaderStyle="{StaticResource LedgerColumnHeaderStyle}"
                                      CellStyle="{StaticResource LedgerCellStyle}"
                                      CellEditEnding="EntriesDataGrid_CellEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="التاريخ" Width="150" MinWidth="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DatePicker SelectedDate="{Binding Date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Language="en-GB"
                                                            FlowDirection="LeftToRight"
                                                            VerticalAlignment="Center" Margin="2" Padding="2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="رصيد اليوم السابق" Width="125" MinWidth="108" IsReadOnly="True"
                                                        Binding="{Binding PreviousBalance, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="5,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="المبلغ الفعلي اليوم" Width="130" MinWidth="110"
                                                        Binding="{Binding ActualAmountToday, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}, UpdateSourceTrigger=PropertyChanged}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="5,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="4,2"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="المبلغ المضاف" Width="115" MinWidth="95" IsReadOnly="True"
                                                        Binding="{Binding AddedAmount, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="5,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="المبلغ المسحوب" Width="115" MinWidth="95" IsReadOnly="True"
                                                        Binding="{Binding TakenAmount, StringFormat='{}{0:N2}', ConverterCulture={x:Static sysglobe:CultureInfo.InvariantCulture}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="5,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="السبب" Width="*" MinWidth="160"
                                                        Binding="{Binding Reason, UpdateSourceTrigger=PropertyChanged}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="5,3"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Padding" Value="4,2"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="AcceptsReturn" Value="True"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SurfacePanelHeaderBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    Padding="16,14" Margin="0,12,4,0" Effect="{StaticResource ModuleCardShadow}" VerticalAlignment="Bottom">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="ملخص الحركة" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="إجمالي المبلغ المضاف:" FontSize="12" Foreground="{DynamicResource TextCaptionBrush}" Margin="0,0,6,6"/>
                        <TextBlock x:Name="TotalAddedText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" Margin="0,0,24,6"/>
                        <TextBlock Text="إجمالي المبلغ المسحوب:" FontSize="12" Foreground="{DynamicResource TextCaptionBrush}" Margin="0,0,6,6"/>
                        <TextBlock x:Name="TotalTakenText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningForegroundBrush}" Margin="0,0,0,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
